# Desarrollo local: completar solo en backend/.env, que Git ignora.
DATABASE_URL=

# Neon: conexión agrupada en DATABASE_URL y conexión directa en DIRECT_URL.
# En desarrollo local, DIRECT_URL puede quedar vacía.
DIRECT_URL=
ACCESS_TOKEN_SECRET=
ITAD_API_KEY=
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Renovación: cookie HttpOnly, Lax en desarrollo y None + Secure en producción.
# En producción se requiere HTTPS y el origen exacto del frontend en CORS_ORIGIN.
# No hace falta otro secreto: el refresh token es aleatorio y se guarda hasheado.

# Funciona mientras el backend esté encendido; Render Free puede suspenderlo.
ENABLE_PRICE_CHECKS=true

# Opcional: avisos por mail. Dejar vacíos hasta configurar Brevo.
BREVO_API_KEY=
EMAIL_FROM=
# Origen público del frontend, sin rutas. En producción debe usar HTTPS.
FRONTEND_URL=http://localhost:5173
