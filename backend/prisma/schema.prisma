generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  // Este campo guarda el hash de bcrypt, nunca la contraseña original.
  password  String
  createdAt DateTime @default(now())

  emailVerifiedAt DateTime?
  emailVerificationHash String? @unique
  emailVerificationExpiresAt DateTime?

  favorites   Favorite[]
  priceAlerts PriceAlert[]
  notifications Notification[]
  refreshSessions RefreshSession[]
}

model RefreshSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  remember  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Game {
  id         Int      @id @default(autoincrement())
  itadGameId String   @unique
  createdAt  DateTime @default(now())

  favorites    Favorite[]
  priceAlerts  PriceAlert[]
}

model Store {
  id          Int      @id @default(autoincrement())
  itadStoreId String   @unique
  name        String?
  createdAt   DateTime @default(now())

}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  createdAt DateTime @default(now())
  saleNotified Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  // Un usuario no puede guardar dos veces el mismo juego como favorito.
  @@unique([userId, gameId])
  @@index([gameId])
}

model PriceAlert {
  id          Int      @id @default(autoincrement())
  userId      Int
  gameId      Int
  targetPrice Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  currency    String
  createdAt   DateTime @default(now())
  notified    Boolean @default(false)
  emailEnabled Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@index([userId])
  @@index([gameId])
  @@unique([userId, gameId])
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  itadGameId String
  gameTitle String
  type String
  price Decimal @db.Decimal(12, 2)
  currency String
  storeName String
  createdAt DateTime @default(now())
  readAt DateTime?
  emailStatus String @default("none")
  emailPayload Json?
  emailAttempts Int @default(0)
  emailNextAttemptAt DateTime?
  emailClaimedAt DateTime?
  emailSentAt DateTime?
  emailProviderId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([emailStatus, emailNextAttemptAt])
}
