generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  // Este campo guarda el hash de bcrypt, nunca la contraseña original.
  password  String
  createdAt DateTime @default(now())

  favorites   Favorite[]
  priceAlerts PriceAlert[]
  notifications Notification[]
}

model Game {
  id         Int      @id @default(autoincrement())
  itadGameId String   @unique
  createdAt  DateTime @default(now())

  favorites    Favorite[]
  priceAlerts  PriceAlert[]
  priceRecords PriceRecord[]
}

model Store {
  id          Int      @id @default(autoincrement())
  itadStoreId String   @unique
  name        String?
  createdAt   DateTime @default(now())

  priceRecords PriceRecord[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  createdAt DateTime @default(now())
  saleNotified Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  // Un usuario no puede guardar dos veces el mismo juego como favorito.
  @@unique([userId, gameId])
  @@index([gameId])
}

model PriceAlert {
  id          Int      @id @default(autoincrement())
  userId      Int
  gameId      Int
  targetPrice Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  currency    String
  createdAt   DateTime @default(now())
  notified    Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@index([userId])
  @@index([gameId])
  @@unique([userId, gameId])
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  itadGameId String
  gameTitle String
  type String
  price Decimal @db.Decimal(12, 2)
  currency String
  storeName String
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PriceRecord {
  id         Int      @id @default(autoincrement())
  gameId     Int
  storeId    Int
  price      Decimal  @db.Decimal(12, 2)
  currency   String
  recordedAt DateTime @default(now())

  game  Game  @relation(fields: [gameId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([gameId, recordedAt])
  @@index([gameId, storeId, recordedAt])
  @@index([storeId])
}
